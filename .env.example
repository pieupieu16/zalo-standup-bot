# ============================================================
# Zalo Daily Standup Bot - Biến môi trường
# ============================================================
# Copy file này thành .env và điền thông tin thật vào
# KHÔNG commit file .env lên Git!

# ----------------------------------------------------------
# Zalo cá nhân
# Lấy Cookie & IMEI bằng extension trình duyệt:
#   1. Cài extension "Get Cookie & IMEI Zalo" trên Chrome/Cốc Cốc
#   2. Đăng nhập vào https://chat.zalo.me
#   3. Bấm vào extension → copy Cookie và IMEI
# ----------------------------------------------------------
ZALO_PHONE=0901234567
ZALO_IMEI=your_imei_here
ZALO_COOKIES={"zpw_sek": "...", "zpw_sekm": "..."}

# ----------------------------------------------------------
# Nhóm Zalo
# Group ID: xem hướng dẫn trong README.md
# ----------------------------------------------------------
ZALO_GROUP_ID=your_group_id_here

# ----------------------------------------------------------
# Cấu hình lịch gửi (tuỳ chọn)
# ----------------------------------------------------------
STANDUP_HOUR=9
STANDUP_MINUTE=0
TIMEZONE=Asia/Ho_Chi_Minh
